@model List<AdminProjectRowViewModel>
@{
    ViewData["Title"] = "Projects";
    Layout = "_AdminLayout";

    // Not named "page": Razor parses a bare @page as the page directive.
    var currentPage = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
}

<div class="admin-head">
    <div>
        <h1>Projects</h1>
        <p>Everything on /projects, including items hidden from the public site.</p>
    </div>
    <div class="admin-head__actions">
        <a class="btn btn--primary" href="/admin/projects/create">New project</a>
    </div>
</div>

<section class="panel">
    @if (Model.Count > 0)
    {
        <div class="table-wrap">
            <table class="data-table">
                <caption class="visually-hidden">All projects</caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Cover image</span></th>
                        <th scope="col">Title</th>
                        <th scope="col">Category</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Completed</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model)
                    {
                        <tr>
                            <td>
                                <img class="data-table__thumb"
                                     src="@project.DisplayImageUrl"
                                     alt=""
                                     width="56" height="40"
                                     loading="lazy" />
                            </td>
                            <td>@project.Title</td>
                            <td>@project.Category</td>
                            <td>@(string.IsNullOrWhiteSpace(project.Duration) ? "—" : project.Duration)</td>
                            <td class="num">
                                @(project.CompletionDate?.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")
                            </td>
                            <td>
                                @* Badge carries a word, so status never depends on colour *@
                                @if (project.IsActive)
                                {
                                    <span class="badge badge--live">Live</span>
                                }
                                else
                                {
                                    <span class="badge badge--hidden">Hidden</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a class="btn btn--secondary btn--sm" href="/admin/projects/edit/@project.Id">
                                        Edit<span class="visually-hidden"> @project.Title</span>
                                    </a>

                                    <form method="post"
                                          action="/admin/projects/delete/@project.Id"
                                          asp-antiforgery="false"
                                          data-confirm="Delete “@project.Title”? This also removes its gallery images and cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn--danger btn--sm" type="submit">
                                            Delete<span class="visually-hidden"> @project.Title</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="panel__body">
                <nav class="pagination" aria-label="Project pages">
                    @if (currentPage > 1)
                    {
                        <a class="btn btn--secondary btn--sm" href="/admin/projects?page=@(currentPage - 1)" rel="prev">&larr; Previous</a>
                    }

                    <span class="pagination__status tnum">Page @currentPage of @totalPages</span>

                    @if (currentPage < totalPages)
                    {
                        <a class="btn btn--secondary btn--sm" href="/admin/projects?page=@(currentPage + 1)" rel="next">Next &rarr;</a>
                    }
                </nav>
            </div>
        }
    }
    else
    {
        <div class="admin-empty">
            <h2>No projects yet</h2>
            <p>Create your first project and it will show on the public site straight away.</p>
            <a class="btn btn--primary" href="/admin/projects/create">Create a project</a>
        </div>
    }
</section>
