@model ProjectListViewModel
@{
    ViewData["Title"] = T["Projects"].Value;
    ViewData["Description"] = T["Completed construction projects by ABC Construction — commercial, residential and industrial work with durations and completion dates."].Value;

    // Keeps the active category when paging, so filter state survives navigation.
    string PageUrl(int page) =>
        string.IsNullOrWhiteSpace(Model.SelectedCategory)
            ? $"/projects?page={page}"
            : $"/projects?page={page}&category={Uri.EscapeDataString(Model.SelectedCategory)}";
}

<section class="detail-hero">
    <div class="container">
        <p class="eyebrow">@T["Our work"]</p>
        <h1>@T["Projects"]</h1>
        <p class="hero__lead" style="margin-bottom:0;">
            @T["Completed work, with the duration each job actually took and the month it was handed over."]
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        @if (Model.Categories.Count > 0)
        {
            @* Links, not JS — every filter is a real, shareable URL *@
            <nav class="filter-bar" aria-label="@T["Filter projects by category"].Value">
                <a class="filter-chip"
                   href="/projects"
                   aria-current="@(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "true" : null)">
                    @T["All work"]
                </a>

                @foreach (var category in Model.Categories)
                {
                    var isSelected = string.Equals(category.Value, Model.SelectedCategory, StringComparison.OrdinalIgnoreCase);
                    <a class="filter-chip"
                       href="/projects?category=@Uri.EscapeDataString(category.Value)"
                       aria-current="@(isSelected ? "true" : null)">
                        @category.Label
                    </a>
                }
            </nav>
        }

        @if (Model.Projects.Count > 0)
        {
            @* Card titles are h3. Without this the page would jump h1 -> h3,
               so the grid gets a real (if visually redundant) section heading. *@
            <h2 class="visually-hidden">
                @(string.IsNullOrWhiteSpace(Model.SelectedCategory)
                    ? T["All projects"]
                    : T["{0} projects", Model.SelectedCategoryLabel!])
            </h2>

            @* role="status" so filtering announces the new result count *@
            <p class="visually-hidden" role="status">
                @T["Showing {0} of {1} projects.", Model.Projects.Count, Model.TotalCount]
            </p>

            <div class="card-grid">
                @foreach (var project in Model.Projects)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="@T["Project pages"].Value">
                    @if (Model.HasPrevious)
                    {
                        <a class="btn btn--secondary btn--sm" href="@PageUrl(Model.Page - 1)" rel="prev">
                            &larr; @T["Previous"]
                        </a>
                    }
                    else
                    {
                        <span class="btn btn--secondary btn--sm" aria-disabled="true">&larr; @T["Previous"]</span>
                    }

                    <span class="pagination__status tnum">
                        @T["Page {0} of {1}", Model.Page, Model.TotalPages]
                    </span>

                    @if (Model.HasNext)
                    {
                        <a class="btn btn--secondary btn--sm" href="@PageUrl(Model.Page + 1)" rel="next">
                            @T["Next"] &rarr;
                        </a>
                    }
                    else
                    {
                        <span class="btn btn--secondary btn--sm" aria-disabled="true">@T["Next"] &rarr;</span>
                    }
                </nav>
            }
        }
        else
        {
            <div class="empty-state">
                <h2>
                    @(string.IsNullOrWhiteSpace(Model.SelectedCategory)
                        ? T["No projects published yet"]
                        : T["Nothing in this category"])
                </h2>
                <p>
                    @if (string.IsNullOrWhiteSpace(Model.SelectedCategory))
                    {
                        @T["Projects added through the admin panel will appear here."]
                    }
                    else
                    {
                        @T["There are no projects filed under &ldquo;{0}&rdquo; yet.", Model.SelectedCategoryLabel!]
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory))
                {
                    <a class="btn btn--primary" href="/projects">@T["Show all projects"]</a>
                }
            </div>
        }
    </div>
</section>

<section class="cta-band">
    <div class="container cta-band__inner">
        <div>
            <h2>@T["Want something similar built?"]</h2>
            <p>@T["Tell us what you are planning and we will give you a straight answer on cost and programme."]</p>
        </div>
    </div>
</section>
