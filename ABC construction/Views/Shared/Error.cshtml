@{
    ViewData["Title"] = "Something went wrong";
    var correlationId = ViewData["CorrelationId"] as string;
    var statusCode = ViewData["StatusCode"] as int?;
    var isNotFound = statusCode == 404;
}

<section class="section">
    <div class="container container--narrow">
        <p class="eyebrow">@(isNotFound ? "Error 404" : "Error")</p>

        <h1>@(isNotFound ? "Page not found" : "Something went wrong")</h1>

        <p class="prose">
            @if (isNotFound)
            {
                <text>
                    The page you asked for does not exist, or it has been moved.
                    The links below will get you back on track.
                </text>
            }
            else
            {
                <text>
                    We hit an unexpected problem handling your request. The issue has
                    been logged and will be looked at. Please try again in a moment.
                </text>
            }
        </p>

        <div class="hero__actions" style="margin-top: var(--sp-6);">
            <a class="btn btn--primary" href="/">
                Back to home
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn btn--secondary" href="/projects">View projects</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(correlationId))
        {
            @* Given to support so a specific failure can be found in the logs *@
            <p style="margin-top: var(--sp-6); font-size: var(--fs-sm); color: var(--text-secondary);">
                Reference code:
                <code style="font-family: var(--font-mono);">@correlationId</code>
            </p>
        }
    </div>
</section>
