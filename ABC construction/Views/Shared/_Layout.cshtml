@{
    // Current controller drives the active nav marker, so it stays correct
    // whether the user arrived by link, deep link or browser back.
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";

    // Returning null omits the attribute entirely — Razor drops null-valued
    // attributes, so inactive links get no aria-current at all.
    string? NavState(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    var language = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // The switcher sends the visitor back to the page (and filter) they were on.
    var returnUrl = Uri.EscapeDataString($"{Context.Request.Path}{Context.Request.QueryString}");

    string? LanguageState(string code) => language == code ? "true" : null;
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <!-- Zoom deliberately left enabled -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is null ? "ABC Construction" : ViewData["Title"] + " — ABC Construction")</title>
    <meta name="description" content="@(ViewData["Description"] ?? T["ABC Construction is a construction and fit-out company delivering high-quality, reliable spaces on time and on budget, from design through final handover."].Value)" />
    <meta name="theme-color" content="#0A0A0A" />

    <link rel="icon" href="~/images/favicon.svg" type="image/svg+xml" />

    @* display=swap avoids invisible text while the webfont loads. Barlow has
       no Georgian letters, so Noto Sans Georgian supplies them; the browser
       only downloads it on pages that contain Georgian text. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&family=Noto+Sans+Georgian:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@T["Skip to main content"]</a>

    <header class="site-header">
        <div class="container site-header__bar">
            <a class="brand" href="/" aria-label="@T["ABC Construction — home"].Value">
                <span class="brand__mark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
                        <path d="M3 21h18" />
                        <path d="M5 21V9l7-5 7 5v12" />
                        <path d="M10 21v-6h4v6" />
                    </svg>
                </span>
                <span class="brand__name">ABC<span>Construction</span></span>
            </a>

            <nav class="nav" aria-label="@T["Main"].Value">
                <ul class="nav__list">
                    <li><a class="nav__link" href="/" aria-current="@NavState("Home")">@T["Home"]</a></li>
                    <li><a class="nav__link" href="/projects" aria-current="@NavState("Projects")">@T["Projects"]</a></li>
                    <li><a class="nav__link" href="/employees" aria-current="@NavState("Employees")">@T["Team"]</a></li>
                    <li><a class="nav__link" href="/contact" aria-current="@NavState("Contact")">@T["Contact"]</a></li>
                </ul>
            </nav>

            <div class="site-header__end">
                @* Each option is labelled in its own language, so a visitor who
                   cannot read the current one still recognises theirs. *@
                <nav class="lang-switch" aria-label="@T["Language"].Value">
                    <a class="lang-switch__link" href="/language/ka?returnUrl=@returnUrl"
                       lang="ka" hreflang="ka" rel="nofollow" aria-current="@LanguageState("ka")">
                        <span aria-hidden="true">ქარ</span>
                        <span class="visually-hidden">ქართული</span>
                    </a>
                    <a class="lang-switch__link" href="/language/en?returnUrl=@returnUrl"
                       lang="en" hreflang="en" rel="nofollow" aria-current="@LanguageState("en")">
                        <span aria-hidden="true">ENG</span>
                        <span class="visually-hidden">English</span>
                    </a>
                </nav>

                <button class="nav-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls="mobile-nav"
                        aria-label="@T["Open menu"].Value"
                        data-label-open="@T["Open menu"].Value"
                        data-label-close="@T["Close menu"].Value"
                        data-nav-toggle>
                    <span class="nav-toggle__bars" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <nav class="mobile-nav" id="mobile-nav" data-open="false" aria-label="@T["Main (mobile)"].Value">
            <ul class="mobile-nav__list">
                <li><a class="mobile-nav__link" href="/" aria-current="@NavState("Home")">@T["Home"]</a></li>
                <li><a class="mobile-nav__link" href="/projects" aria-current="@NavState("Projects")">@T["Projects"]</a></li>
                <li><a class="mobile-nav__link" href="/employees" aria-current="@NavState("Employees")">@T["Team"]</a></li>
                <li><a class="mobile-nav__link" href="/contact" aria-current="@NavState("Contact")">@T["Contact"]</a></li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <div class="hazard" role="presentation"></div>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__grid">
                <div class="site-footer__brand">
                    <span class="brand">
                        <span class="brand__mark" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
                                <path d="M3 21h18" />
                                <path d="M5 21V9l7-5 7 5v12" />
                                <path d="M10 21v-6h4v6" />
                            </svg>
                        </span>
                        <span class="brand__name">ABC<span>Construction</span></span>
                    </span>
                    <p class="prose">@T["Construction and fit-out, from design and installation to final handover. High-quality, reliable spaces delivered on time and on budget."]</p>
                </div>

                <div>
                    <h2>@T["Site"]</h2>
                    <ul class="site-footer__links">
                        <li><a href="/">@T["Home"]</a></li>
                        <li><a href="/projects">@T["Projects"]</a></li>
                        <li><a href="/employees">@T["Team"]</a></li>
                        <li><a href="/contact">@T["Contact"]</a></li>
                    </ul>
                </div>

                <div>
                    <h2>@T["Get in touch"]</h2>
                    <ul class="site-footer__links">
                        <li><a href="/contact">@T["Request a quote"]</a></li>
                        @* The sign-in page is deliberately not advertised to visitors:
                           staff reach it by bookmark, so a public link only invites
                           passers-by to try passwords against it. Signed-in staff keep
                           a way back to the panel from any public page. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a href="/admin">@T["Admin dashboard"]</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="site-footer__bottom">
                <span>@T["&copy; {0} ABC Construction. All rights reserved.", DateTime.UtcNow.Year]</span>
                <span>@T["Built for durability."]</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
